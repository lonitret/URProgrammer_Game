--- !u!114 &1866026666
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1866026665}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 747a4562895fda447bcd277034f0946f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  panel: {fileID: 1449903054}
  titleText: {fileID: 965739941}
  bodyText: {fileID: 1188070535}
  progressText: {fileID: 219270764}
  nextButton: {fileID: 1426734468}
  skipButton: {fileID: 678990285}
  nextButtonText: {fileID: 2055610783}
  showOnStart: 1
  pauseWhileOpen: 1
  steps:
  - title: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C"
    body: "\u0422\u044B \u0441\u0442\u0430\u0436\u0435\u0440-\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442
      \u0432 \u043E\u0444\u0438\u0441\u0435. \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430
      - \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C,
      \u0447\u0438\u043D\u0438\u0442\u044C \u0442\u0435\u0445\u043D\u0438\u043A\u0443
      \u0438 \u043D\u0435 \u0434\u043E\u0432\u0435\u0441\u0442\u0438 \u0441\u0442\u0440\u0435\u0441\u0441
      \u0434\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430."
  - title: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    body: "WASD - \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. E - \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u0441 \u043A\u043E\u043B\u043B\u0435\u0433\u0430\u043C\u0438 \u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438.
      Escape - \u043F\u0430\u0443\u0437\u0430."
  - title: "\u0417\u0430\u0434\u0430\u043D\u0438\u044F"
    body: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u043A\u043E\u043B\u043B\u0435\u0433\u0435
      \u0438 \u043D\u0430\u0436\u043C\u0438 E, \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u044F\u0442\u044C
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435. \u041F\u043E\u043A\u0430 \u0437\u0430\u0434\u0430\u043D\u0438\u0435
      \u0430\u043A\u0442\u0438\u0432\u043D\u043E, \u0434\u0440\u0443\u0433\u0438\u0435
      \u043A\u0432\u0435\u0441\u0442\u044B \u0438 \u0447\u0443\u0436\u0438\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u0431\u0443\u0434\u0443\u0442 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B."
  - title: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u0441\u0442\u0440\u0435\u0441\u0441"
    body: "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439
      \u0438 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0441\u0442\u0440\u0435\u0441\u0441\u0430.
      \u041A\u043E\u0444\u0435 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u0437 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043F\u043E
      \u043A\u043D\u043E\u043F\u043A\u0435 F."
