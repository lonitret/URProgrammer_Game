  m_Script: {fileID: 11500000, guid: d3622abe24bfdf94bba6303b311eb51c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCQuestGiver
  questType: 1
  npcName: "\u041A\u043E\u043B\u043B\u0435\u0433\u0430 3"
  startQuestDialogue:
    npcName: 
    sentences:
    - "\u0418\u043D\u0435\u0442 \u0431\u0430\u0440\u0430\u0445\u043B\u0438\u0442
      \u0422\u044B \u0436\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442,
      \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u0447\u0442\u043E \u0442\u0430\u043C?"
  declineQuestDialogue:
    npcName: 
    sentences:
    - "\u041C\u0434\u0430, \u044F\u0441\u043D\u043E \u043A\u0430\u043A\u043E\u0439-\u0442\u044B
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442.."
  progressQuestDialogue:
    npcName: "\u0422\u044B \u0440\u0430\u0437\u0432\u0435 \u0443\u0436\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u043B
      \u0440\u043E\u0443\u0442\u0435\u0440?"
    sentences:
    - "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0439\u0434\u0438
      \u0442\u043E\u043D\u0435\u0440, \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043E\u0439\u0434\u0438
      \u043A \u043F\u0440\u0438\u043D\u0442\u0435\u0440\u0443."
  completeQuestDialogue:
    npcName: 
    sentences:
    - "\u041E, \u0432\u0441\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E! \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\u044B
      \u0443\u043C\u0435\u044E\u0442 \u0434\u0435\u043B\u0430\u0442\u044C \u0432\u0441\u0451!"
  postQuestDialogue:
    npcName: 
    sentences:
    - "\u0425\u043C.. \u0447\u0442\u043E\u0431\u044B \u0435\u0449\u0435 \u043F\u043E\u0434\u0435\u043B\u0430\u0442\u044C.."
