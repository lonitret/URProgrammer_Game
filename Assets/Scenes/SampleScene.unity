  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d3622abe24bfdf94bba6303b311eb51c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCQuestGiver
  questType: 1
  npcName: "\u041A\u043E\u043B\u043B\u0435\u0433\u0430 2"
  startQuestDialogue:
    npcName: 
    sentences:
    - "\u041F\u0440\u0438\u043D\u0442\u0435\u0440 \u0441\u043D\u043E\u0432\u0430
      \u043C\u0438\u0433\u0430\u0435\u0442. \u0422\u044B \u0436\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442,
      \u0441\u0445\u043E\u0434\u0438 \u0437\u0430\u043F\u0440\u0430\u0432\u044C \u043A\u0430\u0440\u0442\u0440\u0438\u0434\u0436?
      \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0441\u043F\u0435\u0440\u0432\u0430
      \u043D\u0430\u0439\u0434\u0438 \u0442\u043E\u043D\u0435\u0440."
  declineQuestDialogue:
    npcName: 
    sentences:
    - "\u041C\u0434\u0430, \u044F\u0441\u043D\u043E \u043A\u0430\u043A\u043E\u0439-\u0442\u044B
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442.."
  progressQuestDialogue:
    npcName: "\u0422\u044B \u0440\u0430\u0437\u0432\u0435 \u0443\u0436\u0435 \u0437\u0430\u043F\u0440\u0430\u0432\u0438\u043B
      \u043F\u0440\u0438\u043D\u0442\u0435\u0440?"
    sentences:
    - "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0439\u0434\u0438
      \u0442\u043E\u043D\u0435\u0440, \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043E\u0439\u0434\u0438
      \u043A \u043F\u0440\u0438\u043D\u0442\u0435\u0440\u0443."
  completeQuestDialogue:
    npcName: 
    sentences:
    - "\u041E, \u043F\u0435\u0447\u0430\u0442\u0430\u0435\u0442! \u0417\u043D\u0430\u0447\u0438\u0442,
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043C\u0430\u0433\u0438."
  postQuestDialogue:
    npcName: 
    sentences:
    - "\u0425\u043C.. \u0447\u0442\u043E\u0431\u044B \u0435\u0449\u0435 \u043F\u043E\u0434\u0435\u043B\u0430\u0442\u044C.."
  questTitleOverride: 
  firstStepOverride: 
  returnStepOverride: 
  firstObjectiveMarkerTarget: {fileID: 1344765504}
  nextObjectiveMarkerTarget: {fileID: 56198564}
  itemNeededToUseNextObjectiveMarker: {fileID: 11400000, guid: 76673a44f2ebd3d4f85c122155f7bd66, type: 2}
