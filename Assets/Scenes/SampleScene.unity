  m_EditorClassIdentifier: Assembly-CSharp::NPCQuestGiver
  questType: 1
  npcName: "\u041A\u043E\u043B\u043B\u0435\u0433\u0430"
  startQuestDialogue:
    npcName: 
    sentences:
    - "\u041F\u0440\u0438\u0432\u0435\u0442! \u0422\u044B \u0436\u0435 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442?
      \u041F\u043E\u0447\u0438\u043D\u0438 \u043A\u043E\u0444\u0435\u043C\u0430\u0448\u0438\u043D\u0443,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
  declineQuestDialogue:
    npcName: 
    sentences:
    - "\u041C\u0434\u0430, \u044F\u0441\u043D\u043E \u043A\u0430\u043A\u043E\u0439-\u0442\u044B
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442.."
  progressQuestDialogue:
    npcName: "\u0422\u044B \u0440\u0430\u0437\u0432\u0435 \u0443\u0436\u0435 \u043F\u043E\u0447\u0438\u043D\u0438\u043B
